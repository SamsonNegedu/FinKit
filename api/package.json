{
  "name": "finkit-api",
  "version": "2.0.0",
  "scripts": {
    "dev": "nest start --watch",
    "predev": "node scripts/install-better-sqlite3.cjs",
    "build": "nest build",
    "start": "node dist/main.js",
    "prestart": "node scripts/install-better-sqlite3.cjs",
    "test": "vitest run",
    "postinstall": "node scripts/install-better-sqlite3.cjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "tsc -p tsconfig.build.json --noEmit && oxlint && oxfmt --check"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "better-sqlite3": "12.8.0",
    "googleapis": "189.0.0",
    "helmet": "8.3.0",
    "jose": "5.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@nestjs/testing": "12.3.2",
    "@stylistic/eslint-plugin": "4.4.1",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.21",
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=26.13.0"
  }
}
