# Copy to .env for local runs. In production these go in the root .env (see ../.env.example).

PORT=3000
# DATA_DIR=./data
# Browser origin allowed to make changes. When set, changing requests must send exactly this Origin.
# Leave unset locally. REQUIRED in production: the API won't start without it.
# ALLOWED_ORIGIN=https://finkit.example.com

# Who may use FinKit, comma separated. Each person sees only their own data.
# The first address also inherits any data from before accounts existed.
# Required in production: with none listed, nobody gets in.
# ALLOWED_USER_EMAILS=you@example.com

# Cloudflare Access (required in production: the server won't start without both)
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=

# Bank sync: off | mock (local test bank) | enablebanking
BANKING_PROVIDER=off
# Hours between scheduled catch-up syncs (default 12, minimum 6, 0 = off). Banks allow only a few unattended reads a day.
# BANKING_AUTO_SYNC_HOURS=12
# BANKING_ENCRYPTION_KEY=          # openssl rand -base64 32; required in production
# BANKING_REDIRECT_URL=https://finkit.example.com/api/banking/callback
# EB_APP_ID=
# EB_PRIVATE_KEY_PATH=/run/secrets/enablebanking.pem

# Google Sheets (optional)
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/run/secrets/google-sa.json
