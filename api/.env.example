# FinKit API environment. Copy to .env for local runs; in production these go in the root .env (see ../example.env).
# Never commit real values.

# --- Server ---
# PORT=3000                  # default 3000
# HOST=127.0.0.1             # default 0.0.0.0 (needed in Docker); 127.0.0.1 keeps a local run private
# DATA_DIR=./data            # where the SQLite database lives (/data in Docker)
# NODE_ENV=development       # production enables the stricter banking and Cloudflare checks below
# ALLOWED_ORIGIN=https://finkit.example.com   # lock CORS to your site in production

# --- Optional features ---
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/run/secrets/google-sa.json   # Google Sheets sync

# --- Cloudflare Access (required in production when banking is on) ---
# The API verifies the Access JWT itself, so it does not trust the network alone.
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=<application audience tag from the Access app>
# BANKING_ADMIN_EMAILS=you@example.com           # who may open Settings > Back office (comma separated)

# --- Bank sync (off by default; the API answers "disabled" and 404s the routes) ---
# off | mock | enablebanking
BANKING_PROVIDER=off
# mock = a fake test bank for local development. Refused in production unless BANKING_ALLOW_MOCK_IN_PROD=1.

# 32 random bytes, base64. Encrypts bank session ids at rest. Required in production.
#   openssl rand -base64 32
# BANKING_ENCRYPTION_KEY=

# Where the bank sends people back after approving. Must match the redirect URL registered with Enable Banking.
# BANKING_REDIRECT_URL=https://finkit.example.com/api/banking/callback

# Enable Banking application (BANKING_PROVIDER=enablebanking). Generate the key pair with ../scripts/gen-banking-keys.sh.
# The private key stays on the server as a mounted secret. Never paste it into chat or commit it.
# EB_APP_ID=<application id from the Enable Banking dashboard>
# EB_PRIVATE_KEY_PATH=/run/secrets/enablebanking.pem
