{
  "cleanUrls": false,
  "directoryListing": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/banks",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/banks/**",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/transactions",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/transactions/**",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/review",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/income",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/analytics",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/analytics/**",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/export",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/settings",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/settings/**",
      "destination": "/app/index.html"
    }
  ],
  "headers": [
    {
      "source": "**",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ]
}
