# FinKit Environment Variables
# Copy this file to .env and fill in your values

# Frontend API URL (optional - defaults to /api for same-origin)
# Set this if API is on a different domain
# VITE_API_URL=https://api.yourdomain.com

# GitHub Container Registry authentication (for pulling images)
# Create a PAT at: https://github.com/settings/tokens
# Required scope: read:packages
GITHUB_USER=your-github-username
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Cloudflare Tunnel token (from Cloudflare Zero Trust dashboard)
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token

# Google Sheets API (for sheet sync) - Optional
# Path to the service account JSON key, as seen inside the API container (mount it as a secret)
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/run/secrets/google-sa.json

# Your site's address. REQUIRED in production (the API won't start without it): CORS is locked to it and
# changing requests must send exactly this Origin.
# ALLOWED_ORIGIN=https://finkit.example.com

# --- Bank sync (Enable Banking). Off unless BANKING_PROVIDER is set. Full notes: api/.env.example ---
# off | mock | enablebanking   (mock is refused in production)
BANKING_PROVIDER=off
# Hours between scheduled catch-up syncs (default 12, minimum 6, 0 = off)
# BANKING_AUTO_SYNC_HOURS=12
# Cloudflare Access: the API verifies the Access token itself. Required in production: the API won't start without both.
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=<audience tag of the Access application>
# ALLOWED_USER_EMAILS=you@example.com    # who may use FinKit; the first address inherits existing data
# openssl rand -base64 32
# BANKING_ENCRYPTION_KEY=
# Must be https in production and registered exactly like this in your Enable Banking app
# BANKING_REDIRECT_URL=https://finkit.example.com/api/banking/callback
# EB_APP_ID=
# EB_PRIVATE_KEY_PATH=/run/secrets/enablebanking.pem
