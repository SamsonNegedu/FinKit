# Copy to .env. Everything in the first section is needed to run in production.
# Optional features are below it, switched off until you uncomment them.

# ============ REQUIRED IN PRODUCTION ============

# Cloudflare Tunnel token (Zero Trust dashboard)
TUNNEL_TOKEN=your-tunnel-token

# Your site's address. The API won't start without it.
ALLOWED_ORIGIN=https://finkit.example.com

# Cloudflare Access sign-in. The API won't start without both.
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=audience-tag-of-the-access-application

# Who may use FinKit (comma separated). The first address inherits any existing data.
ALLOWED_USER_EMAILS=you@example.com

# ============ OPTIONAL ============

# --- Bank sync (Enable Banking) ---
# Set all of these together. More detail: api/.env.example
# BANKING_PROVIDER=enablebanking
# BANKING_ENCRYPTION_KEY=             # openssl rand -base64 32
# BANKING_REDIRECT_URL=https://finkit.example.com/api/banking/callback   # https, registered in your Enable Banking app
# EB_APP_ID=
# EB_PRIVATE_KEY_PATH=/run/secrets/enablebanking.pem                     # put the file at ./secrets/enablebanking.pem
# BANKING_AUTO_SYNC_HOURS=12           # scheduled catch-up; minimum 6, 0 = off
# BANKING_BACKGROUND_REQUEST_CAP=4     # bank requests per account per day without you present (syncs + history backfill)

# --- Google Sheets export ---
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/run/secrets/google-sa.json            # put the file at ./secrets/google-sa.json
